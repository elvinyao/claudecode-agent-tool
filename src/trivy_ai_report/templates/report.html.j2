<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src data:; connect-src 'none'; font-src 'none'; object-src 'none'; media-src 'none'; frame-src 'none'; worker-src 'none'; base-uri 'none'; form-action 'none'">
  <meta name="color-scheme" content="light">
  <title>Trivy 脆弱性整改报告 · {{ report.artifact_name }}</title>
  <style>
    :root {
      --ink: #172033;
      --muted: #647089;
      --line: #dce2eb;
      --surface: #ffffff;
      --canvas: #f4f7fb;
      --navy: #172a46;
      --blue: #2266d3;
      --blue-soft: #eaf2ff;
      --critical: #a61b2b;
      --critical-soft: #fdecef;
      --high: #c2410c;
      --high-soft: #fff0e7;
      --medium: #9a6700;
      --medium-soft: #fff8d9;
      --low: #18794e;
      --low-soft: #e8f7ef;
      --unknown: #586174;
      --unknown-soft: #eef0f4;
      --warning: #8a4b08;
      --warning-soft: #fff5df;
      --shadow: 0 10px 28px rgb(21 42 75 / 8%);
      --radius: 14px;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      color: var(--ink);
      background: var(--canvas);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
        "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
      line-height: 1.6;
    }
    a { color: var(--blue); text-underline-offset: 3px; }
    code {
      padding: .08rem .32rem;
      border: 1px solid #d7dfeb;
      border-radius: 5px;
      background: #f7f9fc;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: .9em;
      overflow-wrap: anywhere;
    }
    h1, h2, h3, p { margin-top: 0; }
    h2 { margin-bottom: 1rem; font-size: 1.35rem; }
    h3 { margin-bottom: .55rem; font-size: 1.08rem; }
    .page { width: min(1180px, calc(100% - 32px)); margin: 0 auto; padding-bottom: 56px; }
    .hero {
      margin-bottom: 24px;
      padding: 36px 0 28px;
      color: #fff;
      background: linear-gradient(120deg, #142641, #244d7e);
      border-bottom: 4px solid #5aa4ff;
    }
    .hero-inner { width: min(1180px, calc(100% - 32px)); margin: 0 auto; }
    .eyebrow {
      margin-bottom: 8px;
      color: #a8d2ff;
      font-size: .76rem;
      font-weight: 750;
      letter-spacing: .12em;
      text-transform: uppercase;
    }
    .hero h1 { margin-bottom: 6px; font-size: clamp(1.7rem, 4vw, 2.7rem); line-height: 1.2; }
    .hero-subtitle { margin-bottom: 22px; color: #d7e7f9; overflow-wrap: anywhere; }
    .meta-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 10px;
    }
    .meta-item {
      min-width: 0;
      padding: 10px 12px;
      border: 1px solid rgb(255 255 255 / 18%);
      border-radius: 10px;
      background: rgb(255 255 255 / 7%);
    }
    .meta-label { display: block; color: #aac4e1; font-size: .72rem; }
    .meta-value { display: block; font-size: .9rem; font-weight: 650; overflow-wrap: anywhere; }
    .panel {
      margin-bottom: 20px;
      padding: 22px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--surface);
      box-shadow: var(--shadow);
    }
    .warning-panel {
      border-color: #edcf9c;
      background: var(--warning-soft);
      box-shadow: none;
    }
    .warning-panel h2 { margin-bottom: .4rem; color: var(--warning); font-size: 1.05rem; }
    .warning-panel ul { margin: .4rem 0 0; padding-left: 1.2rem; }
    .summary-grid {
      display: grid;
      grid-template-columns: repeat(7, minmax(0, 1fr));
      gap: 10px;
    }
    .stat {
      padding: 14px 12px;
      border: 1px solid var(--line);
      border-radius: 11px;
      background: #fafbfd;
    }
    .stat-label { color: var(--muted); font-size: .75rem; }
    .stat-value { display: block; margin-top: 2px; font-size: 1.55rem; font-weight: 800; line-height: 1.2; }
    .stat-critical .stat-value { color: var(--critical); }
    .stat-high .stat-value { color: var(--high); }
    .stat-medium .stat-value { color: var(--medium); }
    .stat-low .stat-value { color: var(--low); }
    .controls { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
    .search-wrap { flex: 1 1 300px; }
    .search-wrap label { display: block; margin-bottom: 5px; color: var(--muted); font-size: .78rem; }
    #finding-search {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid #b9c5d6;
      border-radius: 9px;
      color: var(--ink);
      background: #fff;
      font: inherit;
    }
    #finding-search:focus { outline: 3px solid #cfe3ff; border-color: var(--blue); }
    .severity-filters { display: flex; flex-wrap: wrap; gap: 6px; align-self: flex-end; }
    .filter-button {
      padding: 9px 11px;
      border: 1px solid #b9c5d6;
      border-radius: 999px;
      color: var(--ink);
      background: #fff;
      cursor: pointer;
      font: inherit;
      font-size: .8rem;
      font-weight: 650;
    }
    .filter-button:hover, .filter-button[aria-pressed="true"] {
      border-color: var(--blue);
      color: #fff;
      background: var(--blue);
    }
    .result-count { margin: 12px 0 0; color: var(--muted); font-size: .82rem; }
    .remediation-list { display: grid; gap: 16px; }
    .finding-card {
      border: 1px solid var(--line);
      border-left: 5px solid var(--unknown);
      border-radius: 12px;
      background: #fff;
      overflow: hidden;
      box-shadow: 0 5px 18px rgb(21 42 75 / 6%);
    }
    .finding-card[data-severity="CRITICAL"] { border-left-color: var(--critical); }
    .finding-card[data-severity="HIGH"] { border-left-color: var(--high); }
    .finding-card[data-severity="MEDIUM"] { border-left-color: var(--medium); }
    .finding-card[data-severity="LOW"] { border-left-color: var(--low); }
    .finding-heading {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      padding: 17px 18px;
      border-bottom: 1px solid var(--line);
      background: #fafbfd;
    }
    .finding-heading h3 { margin: 0; overflow-wrap: anywhere; }
    .finding-heading p { margin: 3px 0 0; color: var(--muted); font-size: .84rem; overflow-wrap: anywhere; }
    .badges { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
    .badge {
      display: inline-flex;
      align-items: center;
      width: fit-content;
      padding: 3px 8px;
      border-radius: 999px;
      color: var(--unknown);
      background: var(--unknown-soft);
      font-size: .7rem;
      font-weight: 750;
      white-space: nowrap;
    }
    .badge-critical { color: var(--critical); background: var(--critical-soft); }
    .badge-high { color: var(--high); background: var(--high-soft); }
    .badge-medium { color: var(--medium); background: var(--medium-soft); }
    .badge-low { color: var(--low); background: var(--low-soft); }
    .badge-fact { color: #225c91; background: #e7f2fc; }
    .badge-ai { color: #6043a6; background: #efeafe; }
    .badge-web { color: #11665c; background: #e2f5f2; }
    .badge-warning { color: var(--warning); background: var(--warning-soft); }
    .finding-body { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); }
    .fact-block, .advice-block { min-width: 0; padding: 18px; }
    .fact-block { border-right: 1px solid var(--line); background: #fbfcfe; }
    .block-title { display: flex; gap: 8px; align-items: center; margin-bottom: 12px; }
    .block-title h4 { margin: 0; font-size: .94rem; }
    .fact-list {
      display: grid;
      grid-template-columns: minmax(105px, .5fr) minmax(0, 1.5fr);
      gap: 7px 10px;
      margin: 0;
      font-size: .83rem;
    }
    .fact-list dt { color: var(--muted); }
    .fact-list dd { margin: 0; overflow-wrap: anywhere; }
    .description { margin: 14px 0 0; color: #3d485c; font-size: .83rem; white-space: pre-wrap; }
    .source-links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; font-size: .78rem; }
    .advice-title { margin-bottom: 8px; }
    .advice-rationale { color: #344056; font-size: .88rem; white-space: pre-wrap; }
    .advice-columns { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .steps {
      margin: 7px 0 0;
      padding-left: 1.2rem;
      color: #344056;
      font-size: .84rem;
    }
    .steps li + li { margin-top: 5px; }
    .recommendation-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 14px;
      margin: 13px 0 0;
      padding-top: 12px;
      border-top: 1px dashed var(--line);
      color: var(--muted);
      font-size: .76rem;
    }
    .evidence {
      margin-top: 14px;
      padding: 12px 14px;
      border: 1px solid #bce1dc;
      border-radius: 9px;
      background: #f1fbf9;
    }
    .evidence h5 { margin: 0 0 7px; font-size: .83rem; }
    .evidence ul { margin: 0; padding-left: 1.1rem; font-size: .8rem; }
    .evidence li + li { margin-top: 7px; }
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: .82rem; }
    th, td { padding: 10px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
    th { color: #4b5870; background: #f6f8fb; font-size: .73rem; letter-spacing: .02em; }
    td { overflow-wrap: anywhere; }
    tbody tr:hover { background: #f8fbff; }
    .empty {
      padding: 30px;
      border: 1px dashed #b9c5d6;
      border-radius: 10px;
      color: var(--muted);
      text-align: center;
    }
    [hidden] { display: none !important; }
    .footer { color: var(--muted); font-size: .75rem; text-align: center; }

    @media (max-width: 900px) {
      .meta-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .summary-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
      .finding-body { grid-template-columns: 1fr; }
      .fact-block { border-right: 0; border-bottom: 1px solid var(--line); }
    }
    @media (max-width: 580px) {
      .page, .hero-inner { width: min(100% - 20px, 1180px); }
      .hero { padding-top: 26px; }
      .meta-grid, .summary-grid, .advice-columns { grid-template-columns: 1fr 1fr; }
      .finding-heading { flex-direction: column; }
      .panel { padding: 16px; }
    }
    @media print {
      body { background: #fff; }
      .hero { color: #111; background: #fff; border-bottom-color: #333; }
      .hero-subtitle, .eyebrow, .meta-label { color: #444; }
      .meta-item { border-color: #aaa; }
      .controls-panel { display: none; }
      .panel, .finding-card { box-shadow: none; break-inside: avoid; }
      a { color: #111; }
    }
  </style>
</head>
<body>
  <header class="hero">
    <div class="hero-inner">
      <p class="eyebrow">Trivy · Agent-assisted remediation</p>
      <h1>脆弱性整改报告</h1>
      <p class="hero-subtitle">{{ report.artifact_name }}</p>
      <div class="meta-grid" aria-label="报告元数据">
        <div class="meta-item">
          <span class="meta-label">Artifact 类型</span>
          <span class="meta-value">{{ report.artifact_type or "未提供" }}</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">操作系统</span>
          <span class="meta-value">{% if report.os_family or report.os_version %}{{ report.os_family }} {{ report.os_version }}{% else %}未检测{% endif %}{% if report.os_eosl %} · EOSL{% endif %}</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Agent / Skill</span>
          <span class="meta-value">
            {{ analysis.provider }} · {{ analysis.model }}<br>
            Skill: {{ analysis.skill_name or "未指定" }}
          </span>
        </div>
        <div class="meta-item">
          <span class="meta-label">生成时间</span>
          <span class="meta-value">{{ generated_at }}</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Trivy Schema</span>
          <span class="meta-value">v{{ report.schema_version }}</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Trivy 创建时间</span>
          <span class="meta-value">{{ report.created_at or "未提供" }}</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">联网增强</span>
          <span class="meta-value">{{ "已请求" if analysis.enrich_web else "未启用" }}</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">报告完整性</span>
          <span class="meta-value">{{ "部分完成" if is_partial else "完整" }}</span>
        </div>
      </div>
    </div>
  </header>

  <main class="page">
    {% if warnings %}
    <section class="panel warning-panel" role="alert" aria-labelledby="warning-title">
      <h2 id="warning-title">{% if is_partial %}部分结果警告{% else %}报告说明{% endif %}</h2>
      <ul>
        {% for warning in warnings %}<li>{{ warning }}</li>{% endfor %}
      </ul>
    </section>
    {% endif %}

    <section class="panel" aria-labelledby="summary-title">
      <h2 id="summary-title">风险概览</h2>
      <div class="summary-grid">
        <div class="stat"><span class="stat-label">漏洞总数</span><strong class="stat-value">{{ total_count }}</strong></div>
        <div class="stat"><span class="stat-label">可修复</span><strong class="stat-value">{{ fixable_count }}</strong></div>
        <div class="stat stat-critical"><span class="stat-label">Critical</span><strong class="stat-value">{{ severity_counts.CRITICAL }}</strong></div>
        <div class="stat stat-high"><span class="stat-label">High</span><strong class="stat-value">{{ severity_counts.HIGH }}</strong></div>
        <div class="stat stat-medium"><span class="stat-label">Medium</span><strong class="stat-value">{{ severity_counts.MEDIUM }}</strong></div>
        <div class="stat stat-low"><span class="stat-label">Low</span><strong class="stat-value">{{ severity_counts.LOW }}</strong></div>
        <div class="stat"><span class="stat-label">Unknown</span><strong class="stat-value">{{ severity_counts.UNKNOWN }}</strong></div>
      </div>
    </section>

    {% if findings %}
    <section class="panel controls-panel" aria-labelledby="filter-title">
      <h2 id="filter-title">筛选报告</h2>
      <div class="controls">
        <div class="search-wrap">
          <label for="finding-search">搜索 CVE、包名、版本、Target 或建议</label>
          <input id="finding-search" type="search" placeholder="例如：CVE-2022-22965 或 spring-boot" autocomplete="off">
        </div>
        <div class="severity-filters" aria-label="严重度筛选">
          <button class="filter-button" type="button" data-filter-severity="ALL" aria-pressed="true">全部</button>
          {% for severity in ("CRITICAL", "HIGH", "MEDIUM", "LOW", "UNKNOWN") %}
          <button class="filter-button" type="button" data-filter-severity="{{ severity }}" aria-pressed="false">{{ severity }}</button>
          {% endfor %}
        </div>
      </div>
      <p id="result-count" class="result-count" aria-live="polite">显示 {{ total_count }} / {{ total_count }} 条漏洞</p>
    </section>
    {% endif %}

    <section aria-labelledby="remediation-title">
      <h2 id="remediation-title">优先整改建议</h2>
      {% if findings %}
      <div class="remediation-list">
        {% for finding in findings %}
        <article id="finding-{{ finding.id }}" class="finding-card" data-filter-item data-severity="{{ finding.severity }}" data-search="{{ finding.search_text }}">
          <header class="finding-heading">
            <div>
              <h3>{{ finding.vulnerability_id }} · {{ finding.package_name }}</h3>
              <p>{{ finding.title or "Trivy 未提供漏洞标题" }}</p>
            </div>
            <div class="badges">
              <span class="badge badge-{{ finding.severity | lower }}">{{ finding.severity }}</span>
              <span class="badge">{{ finding.priority }}</span>
              <span class="badge">{{ finding.recommendation.category_label }}</span>
            </div>
          </header>
          <div class="finding-body">
            <section class="fact-block" aria-label="Trivy 事实">
              <div class="block-title"><span class="badge badge-fact">Trivy 事实</span><h4>扫描器原始字段</h4></div>
              <dl class="fact-list">
                <dt>Vulnerability</dt><dd><code>{{ finding.vulnerability_id }}</code></dd>
                <dt>Package</dt><dd><code>{{ finding.package_name }}</code>{% if finding.package_id %}<br>{{ finding.package_id }}{% endif %}</dd>
                <dt>InstalledVersion</dt><dd><code>{{ finding.installed_version or "未提供" }}</code></dd>
                <dt>FixedVersion</dt><dd><code>{{ finding.fixed_version or "未提供" }}</code></dd>
                <dt>Status</dt><dd>{{ finding.status or "未提供" }} · {{ "可修复" if finding.is_fixable else "未确认可修复" }}</dd>
                <dt>Target</dt><dd>{{ finding.target or "未提供" }}</dd>
                <dt>Class / Type</dt><dd>{{ finding.target_class or "未提供" }} / {{ finding.target_type or "未提供" }}</dd>
                {% if finding.package_path %}<dt>Path</dt><dd><code>{{ finding.package_path }}</code></dd>{% endif %}
              </dl>
              {% if finding.description %}<p class="description">{{ finding.description }}</p>{% endif %}
              {% if finding.links %}
              <div class="source-links">
                {% for link in finding.links %}
                <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer nofollow">{{ link.label }}</a>
                {% endfor %}
              </div>
              {% endif %}
            </section>

            <section class="advice-block" aria-label="AI 建议">
              <div class="block-title">
                <span class="badge badge-ai">AI 建议</span>
                <span class="badge {% if finding.recommendation.research_status == 'enriched' %}badge-web{% elif finding.recommendation.research_status in ('failed', 'not_found') %}badge-warning{% endif %}">{{ finding.recommendation.research_label }}</span>
              </div>
              <h4 class="advice-title">{{ finding.recommendation.title }}</h4>
              <p class="advice-rationale">{{ finding.recommendation.rationale }}</p>
              <div class="advice-columns">
                <div>
                  <h4>修改步骤</h4>
                  <ol class="steps">{% for step in finding.recommendation.actions %}<li>{{ step }}</li>{% endfor %}</ol>
                </div>
                <div>
                  <h4>验证方式</h4>
                  <ol class="steps">{% for step in finding.recommendation.validation %}<li>{{ step }}</li>{% endfor %}</ol>
                </div>
              </div>
              <div class="recommendation-meta">
                <span>建议版本：<strong>{{ finding.recommendation.recommended_version or "未指定" }}</strong></span>
                <span>版本依据：<strong>{{ finding.recommendation.version_source_label }}</strong></span>
                <span>置信度：<strong>{{ finding.recommendation.confidence }}</strong></span>
              </div>
              {% if finding.recommendation.evidence %}
              <aside class="evidence">
                <h5><span class="badge badge-web">联网证据</span> 仅用于补充建议，不覆盖 Trivy 事实</h5>
                <ul>
                  {% for item in finding.recommendation.evidence %}
                  <li><a href="{{ item.url }}" target="_blank" rel="noopener noreferrer nofollow">{{ item.title }}</a> — {{ item.claim }}</li>
                  {% endfor %}
                </ul>
              </aside>
              {% endif %}
            </section>
          </div>
        </article>
        {% endfor %}
      </div>
      {% else %}
      <div class="empty">该 Trivy 报告中没有漏洞 finding，因此未调用 Agent 生成整改建议。</div>
      {% endif %}
    </section>

    {% if findings %}
    <section class="panel" aria-labelledby="table-title" style="margin-top: 24px">
      <h2 id="table-title">漏洞明细</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>严重度</th><th>漏洞</th><th>包</th><th>当前版本</th><th>修复版本</th><th>Target</th><th>建议</th></tr></thead>
          <tbody>
            {% for finding in findings %}
            <tr data-finding-row data-filter-item data-severity="{{ finding.severity }}" data-search="{{ finding.search_text }}">
              <td><span class="badge badge-{{ finding.severity | lower }}">{{ finding.severity }}</span></td>
              <td><a href="#finding-{{ finding.id }}">{{ finding.vulnerability_id }}</a></td>
              <td><code>{{ finding.package_name }}</code></td>
              <td><code>{{ finding.installed_version or "—" }}</code></td>
              <td><code>{{ finding.fixed_version or "—" }}</code></td>
              <td>{{ finding.target or "—" }}</td>
              <td>{{ finding.recommendation.title }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
    {% endif %}

    <p class="footer">本报告将 Trivy 扫描事实与 Agent 建议分层展示。任何整改建议都应经过测试，并以重新扫描结果为准。</p>
  </main>

  <script>
    (() => {
      "use strict";
      const search = document.getElementById("finding-search");
      if (!search) return;
      const buttons = Array.from(document.querySelectorAll("[data-filter-severity]"));
      const items = Array.from(document.querySelectorAll("[data-filter-item]"));
      const rows = Array.from(document.querySelectorAll("[data-finding-row]"));
      const counter = document.getElementById("result-count");
      let activeSeverity = "ALL";

      const applyFilters = () => {
        const query = search.value.trim().toLocaleLowerCase("zh-CN");
        items.forEach((item) => {
          const severityMatches = activeSeverity === "ALL" || item.dataset.severity === activeSeverity;
          const searchMatches = !query || (item.dataset.search || "").includes(query);
          item.hidden = !(severityMatches && searchMatches);
        });
        const visibleRows = rows.filter((row) => !row.hidden).length;
        counter.textContent = `显示 ${visibleRows} / ${rows.length} 条漏洞`;
      };

      search.addEventListener("input", applyFilters);
      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          activeSeverity = button.dataset.filterSeverity || "ALL";
          buttons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
          applyFilters();
        });
      });
    })();
  </script>
</body>
